network:
  version: 2
  ethernets:
    "{{ ether_iface }}":
      dhcp4: false
      addresses:
        - "{{ static_ip }}/24"
      routes:
        - to: default
          via: "{{ gateway | default('192.168.178.1') }}"
      nameservers:
        addresses:
{# Fallback bewusst auf das Gateway und nicht auf oeffentliche Resolver --
   ein stiller Default darf keinen externen DNS-Anbieter einziehen (#40). #}
{% for ns in nameservers | default([gateway | default("192.168.178.1")]) %}
          - "{{ ns }}"
{% endfor %}
      optional: true
