# Longhorn Helm values -- verwaltet von plays/install-longhorn.yml.
#
# Diese Datei ist die EINZIGE Quelle der Longhorn-Werte. Sie hat die frueheren
# `--set`-Flags im Play abgeloest (SmartHomeDeployments #6, 2026-09-19); die
# gleichnamige ConfigMap `longhorn-values` im Cluster war toter Code -- helm bekam
# immer nur `--set` und nie ein `-f`, die ConfigMap wurde also nie gelesen.
#
# Longhorn ist bewusst NICHT in ArgoCD, siehe docs/gitops-grenze.md im Repo
# SmartHomeDeployments. Aenderungen hier greifen erst mit dem naechsten
# `ansible-playbook plays/install-longhorn.yml -K`.
#
# ACHTUNG Typen: `defaultReplicaCount` und `defaultClassReplicaCount` muessen
# Zahlen bleiben, nicht Strings in Anfuehrungszeichen -- sonst erzeugt helm einen
# Diff gegen den laufenden Release, obwohl sich am Wert nichts aendert.
defaultSettings:
  defaultDataPath: {{ longhorn_data_path }}
  createDefaultDiskLabeledNodes: true
  defaultReplicaCount: {{ longhorn_replica_count | int }}
  replicaSoftAntiAffinity: false
  # Loescht Pods auf einem ausgefallenen Node, damit StatefulSet-Pods anderswo
  # starten koennen -- Kubernetes tut das von sich aus nicht.
  nodeDownPodDeletionPolicy: {{ longhorn_node_down_pod_deletion_policy }}
  taintToleration: "node-role.kubernetes.io/master:NoSchedule;node-role.kubernetes.io/control-plane:NoSchedule"
  # Nach einem Chart-Upgrade laufen die Engines der Volumes auf der alten Version
  # weiter, bis sie migriert werden. Longhorns Default `0` heisst: nie automatisch.
  # `1` = eine Engine je Node gleichzeitig, nur bei healthy/detached Volumes. Die
  # Live-Umschaltung wurde beim 1.11-Upgrade gemessen: 6 s je Volume, laengste
  # Schreibpause 1 s, kein Rebuild, kein Pod-Restart. Ohne Automatik bleibt der
  # Cluster gemischt, und uebersprungene Engine-Generationen koennen den naechsten
  # Minor-Sprung verbauen. SmartHomeDeployments #7
  concurrentAutomaticEngineUpgradePerNodeLimit: 1

persistence:
  defaultClass: true
  defaultClassReplicaCount: {{ longhorn_replica_count | int }}

# Der Zugang laeuft ueber den Ingress `longhorn.intern` aus Longhorn.yaml
# (ArgoCD, cluster-ca-issuer). Das Chart soll keinen eigenen Ingress anlegen.
ingress:
  enabled: false

# Ab Chart 1.12 rendert `restrictInternalTraffic: true` (neuer Default) sechs
# NetworkPolicies, auch bei `enabled: false`. k3s setzt NetworkPolicies durch
# (kein --disable-network-policy), und die Policy auf longhorn-manager laesst nur
# Longhorn-eigene Pods zu -- der ServiceMonitor `monitoring/longhorn-manager`
# (Port 9500) waere damit still abgeschnitten. Bewusst aus: das Upgrade soll ein
# reines Upgrade bleiben, der Nutzen der Abschottung ist im LAN-only-Cluster
# gering. Wer sie einschaltet, braucht eine Allow-Policy fuer `monitoring`.
# SmartHomeDeployments #8
networkPolicies:
  enabled: false
  restrictInternalTraffic: false
