@using MQTTnet.Protocol
@using SmartHome.Web.Components.UIComponents
@using SmartHome.Web.Services
@using SmartHomeWebManagers
@using System.Text.Json
@using System.Globalization
@using SharedContracts

@page "/chargingoverview"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject MqttService MqttService


<h3>Laden</h3>

<h4>Quellen und Verbräuche</h4>

@*
    One card, shaped like the wallbox tiles below it: the two halves of this page describe the
    same system and should not look like two applications. The colours are the ones every
    Grafana dashboard uses for these flows (palette in app.css), and the charging power of a
    box is the one the box itself reports — see the remarks in the code below.
*@
<div class="uebersichtBox">
    <div class="flussTitel">Batterie · @_chargingSituation.BatteryLevel %</div>
    <div class="BatteryContainer">
        <div class="BatteryLevel" style="width: @_chargingSituation.BatteryLevel%"></div>
    </div>

    @* Die beiden Balken sind ein Vergleichsinstrument: gleich breit, gleiche Skala,
       unmittelbar übereinander. Zwischen sie gehört nichts — keine Überschrift, keine
       Legende —, sonst liest man sie nicht mehr als Paar. Wie die Erzeugung zum Verbrauch
       steht, liest man aus dem Vergleich ab, nicht aus zwei getrennten Blöcken. *@
    <div class="flussPaar">
        @Balken(Quellen)
        @Balken(Verbraeuche)
    </div>

    @Legende(AlleAnteile)
</div>

<h4>Lade-Einstellungen</h4>


@*
    The six levels. Every level carries its own explanation in Ladestufen below, and the page
    shows that explanation in writing - it used to live in an SfTooltip, which hangs off hover
    and is therefore unreachable on a phone, where this page is mostly used. Two places show
    it, for two different questions:
      - the line under the scale answers "what is set right now" without any interaction,
      - the disclosure answers "what would level 4 do" without having to tap level 4, which
        would publish a real command to the charging controller.
*@
<div class="stepsGrid">
    @foreach (var stufe in Ladestufen)
    {
        <div class="stepsItem">
            @* A button, not a div: it is one on a keyboard and to a screen reader, and it
               gives the browser its own touch target instead of a bare click handler. *@
            <button type="button"
                    class="stepsBox @(chargingSettings.ChargingLevel >= stufe.Nummer ? "stepsBox-active" : "stepsBox-inactive") @(chargingSettings.ChargingLevel == stufe.Nummer ? "stepsBox-gewaehlt" : "")"
                    aria-pressed="@(chargingSettings.ChargingLevel == stufe.Nummer)"
                    @onclick="() => StufeSetzen(stufe.Nummer)">@stufe.Nummer</button>
            <div class="stepsLabel">@stufe.Kurz</div>
        </div>
    }
</div>

<p class="stufeErklaerung">
    <span class="stufeErklaerungKopf">Stufe @GewaehlteStufe.Nummer · @GewaehlteStufe.Kurz</span>
    @GewaehlteStufe.Erklaerung
</p>

<details class="stufenHilfe">
    <summary>Was die Stufen bedeuten</summary>
    <dl class="stufenListe">
        @foreach (var stufe in Ladestufen)
        {
            <dt class="@(chargingSettings.ChargingLevel == stufe.Nummer ? "stufenListe-gewaehlt" : "")">@stufe.Nummer · @stufe.Kurz</dt>
            <dd>@stufe.Erklaerung</dd>
        }
    </dl>
</details>

<h4>Wallboxen</h4>

<div class="wallboxGrid">
    @foreach (var wallbox in LadeTopics.Wallboxen)
    {
        <WallboxStatusVisualizer
            Name="@wallbox"
            Status="@MqttService.Wallboxen.GetValueOrDefault(wallbox)"
            Freigegeben="@IstFreigegeben(wallbox)"
            Priorisiert="@(chargingSettings.PreferedChargingStation == Station(wallbox))"
            FreigabeUmschalten="@(() => FreigabeUmschalten(wallbox))"
            VorrangUmschalten="@(() => VorrangUmschalten(wallbox))"
            Zuordnung="@MqttService.Zuordnungen.GetValueOrDefault(wallbox)"
            Fahrzeuge="@FahrzeugTopics.Fahrzeuge"
            ZuordnungSetzen="@(fahrzeug => ZuordnungSetzen(wallbox, fahrzeug))" />
    }
</div>

<h4>Fahrzeuge</h4>

<div>
    <div class="carsGrid">
        @foreach (var fahrzeug in FahrzeugTopics.Fahrzeuge)
        {
            <CarStatusDataVisualizer
                Name="@fahrzeug"
                CarStatusData="@MqttService.Fahrzeuge.GetValueOrDefault(fahrzeug)" />
        }
    </div>
</div>

@code {
    ChargingSituation _chargingSituation = new ();

    /// <summary>
    /// One charging level: its number, the short name under the circle and the sentence that
    /// says what it actually does. The wording of the explanations is the one the tooltips
    /// carried - it is the only description of the levels that exists anywhere, so it is
    /// copied over rather than rewritten; only "KW"/"Kw" became "kW" and a missing comma was
    /// added.
    /// </summary>
    private record Ladestufe(int Nummer, string Kurz, string Erklaerung);

    private static readonly IReadOnlyList<Ladestufe> Ladestufen =
    [
        new(0, "Aus", "Laden ist deaktiviert."),
        new(1, "PV-Laden mit Batterie-Prio",
            "Lädt das Auto nur mit PV-Überschuss, der 3,8 kW übersteigt."),
        new(2, "PV-Laden mit Auto-Prio",
            "Lädt das Auto, wenn der PV-Überschuss die Mindestladeleistung übersteigt."),
        new(3, "PV + Batterie-Laden",
            "Lädt das Auto, wenn der PV-Überschuss plus Batteriekapazität die Mindestladeleistung "
            + "übersteigt und die Batterie zu mehr als 50 % geladen ist."),
        new(4, "Sofort-Laden", "Lädt das Auto mit mindestens der Mindestladeleistung."),
        new(5, "Schnell-Laden", "Lädt das Auto mit 8 kW."),
    ];

    /// <summary>
    /// The level that is set. A value outside the scale - an older or a newer contract - must
    /// not make the explanation line disappear, so it falls back to "Aus" rather than to null.
    /// </summary>
    private Ladestufe GewaehlteStufe =>
        Ladestufen.FirstOrDefault(s => s.Nummer == chargingSettings.ChargingLevel) ?? Ladestufen[0];

    private AvailabilityData availabilityData = new (); 
    private ConsumptionData consumptionData = new ();
    private SharedContracts.ChargingSettings chargingSettings = new ();

    /// <summary>
    /// One coloured share of a bar, together with its entry in the legend underneath. Bar and
    /// legend are rendered from the same list, so they cannot name different things or paint
    /// the same thing differently — which is how the legend up here and the tiles below
    /// drifted apart in the first place (backlog item 21).
    /// </summary>
    private record Anteil(string Name, int Watt, decimal Prozent, string Farbe);

    /// <summary>
    /// One bar. Segments without width are left out — with a gap between the segments an
    /// invisible one would still take up space.
    /// </summary>
    private RenderFragment Balken(IReadOnlyList<Anteil> anteile) => @<text>
        <div class="AvailabilityComponent">
            @foreach (var anteil in anteile.Where(a => a.Prozent > 0))
            {
                <div class="AvailabilityLevel" title="@anteil.Name"
                     style="width: @Breite(anteil.Prozent); background-color: @anteil.Farbe"></div>
            }
        </div>
    </text>;

    /// <summary>
    /// The one legend for both bars. It keeps every entry, including the ones at zero: the
    /// grid and the battery cross zero several times a minute, and a legend that loses and
    /// regains entries in the process changes its width and its line break while one is
    /// reading it. "Netzeinspeisung: 0 W" is a statement worth reading anyway. The bars filter
    /// at <c>Prozent &gt; 0</c> for the opposite reason — an invisible segment there costs a gap.
    /// </summary>
    private RenderFragment Legende(IReadOnlyList<Anteil> anteile) => @<text>
        <div class="LegendContainer">
            @foreach (var anteil in anteile)
            {
                <div class="LegendGroup">
                    <div class="LegendColorIndicator" style="background-color: @anteil.Farbe"></div>
                    <div>@anteil.Name: <span class="nowrap">@FormatPower(anteil.Watt)</span></div>
                </div>
            }
        </div>
    </text>;

    /// <summary>Where the power comes from, in the order of the bar.</summary>
    private IReadOnlyList<Anteil> Quellen =>
    [
        new("PV", _chargingSituation.PowerFromPV, availabilityData.PVPowerPercent,
            "var(--laden-farbe-pv)"),
        // Only the discharging half. The other direction is a consumption, appears below as
        // "Batterie laden" and has a colour of its own; a single signed entry would have to
        // stand in both bars for them to add up, and one of the two would show a minus.
        new("Batterie", Positiv(_chargingSituation.PowerFromBattery), availabilityData.BatteryPowerPercent,
            "var(--laden-farbe-batterie)"),
        new("Netzbezug", Positiv(_chargingSituation.PowerFromGrid), availabilityData.GridPowerPercent,
            "var(--laden-farbe-netzbezug)"),
    ];

    /// <summary>
    /// Where the same power goes, in the order of the bar. Both bars split up one and the same
    /// total, which is why the two directions of battery and grid appear once on each side.
    /// </summary>
    private IReadOnlyList<Anteil> Verbraeuche =>
    [
        new("Haus", HausOhneWallboxen, consumptionData.HouseConsumption, "var(--laden-farbe-haus)"),
        new("Batterie laden", Positiv(-_chargingSituation.PowerFromBattery), consumptionData.BatteryCharging,
            "var(--laden-farbe-batterie-laden)"),
        new("Netzeinspeisung", Positiv(-_chargingSituation.PowerFromGrid), consumptionData.GridFeed,
            "var(--laden-farbe-netzeinspeisung)"),
        // The names come from LadeTopics, like everywhere else on this page: the box on the
        // parking space is called Stellplatz, and a second spelling for it is how "Außen"
        // survived up here after points 7 and 8 had renamed it everywhere else.
        .. LadeTopics.Wallboxen.Select(wallbox => new Anteil(
            wallbox, Ladeleistung(wallbox), WallboxAnteil(wallbox), WallboxFarbe(wallbox))),
    ];

    /// <summary>
    /// Both bars in one legend, sources first, in the order the bars above name them. Two
    /// legends would have to sit between the bars or below each other, and either way the two
    /// bars stop being readable as a pair.
    /// </summary>
    private IReadOnlyList<Anteil> AlleAnteile => [.. Quellen, .. Verbraeuche];

    /// <summary>
    /// Width of one segment, as CSS needs it: a dot as the decimal separator.
    /// </summary>
    /// <remarks>
    /// The application runs under de-DE (Program.cs sets it), so a decimal renders as "11,28".
    /// "width: 11,28%" is not a valid CSS length, the browser drops the whole declaration, and
    /// the segment ends up 0 px wide - the bar is simply empty. It never showed while the share
    /// was an integer; it appeared the moment the integer division in
    /// ChargingSituationManager.CalculatePowerPercent was fixed. CarStatusDataVisualizer does
    /// the same thing for the battery height, for the same reason.
    ///
    /// Two decimals are enough: on a 350 px bar that is a twentieth of a pixel.
    /// </remarks>
    private static string Breite(decimal prozent) =>
        prozent.ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static int Positiv(int watt) => Math.Max(0, watt);

    /// <summary>
    /// Charging power of one box, as the box itself reports it — the same number the tile
    /// below shows, so the two halves of the page can no longer name different powers for the
    /// same box. The ChargingSituation carries the value as well, but only as of the last
    /// control cycle (5 s), and that is the lag the tiles made visible.
    /// </summary>
    private int Ladeleistung(string wallbox) =>
        MqttService.Wallboxen.GetValueOrDefault(wallbox)?.Ladeleistung ?? 0;

    /// <summary>
    /// What the house draws apart from the wallboxes. All three operands deliberately come
    /// from the same ChargingSituation snapshot: HouseConsumptionPower contains the boxes, so
    /// subtracting the fresher readings of <see cref="Ladeleistung"/> from a total that is up
    /// to one control cycle older would count a load change twice and can make the difference
    /// negative. The number is therefore exactly as old as the PV, battery and grid figures
    /// next to it — which is what keeps the bar a picture of one single moment.
    /// </summary>
    private int HausOhneWallboxen =>
        _chargingSituation.HouseConsumptionPower
        - _chargingSituation.InsideCurrentChargingPower
        - _chargingSituation.OutsideCurrentChargingPower;

    /// <summary>
    /// Share of the consumption bar that belongs to one box. Taken from the ChargingSituation
    /// like every other segment of that bar, for the reason given on
    /// <see cref="HausOhneWallboxen"/>: the bar divides up one total and has to add up, while
    /// the number read out in the legend comes from the box itself.
    /// </summary>
    /// <remarks>
    /// ConsumptionData still has one property per box — a third box would need a line here and
    /// one there, which is a question for the contract, not for this page.
    /// </remarks>
    private decimal WallboxAnteil(string wallbox) => wallbox switch
    {
        LadeTopics.Garage => consumptionData.GarageCharging,
        LadeTopics.Stellplatz => consumptionData.OutsideCharging,
        _ => 0,
    };

    /// <summary>Colour of a box, from the charging palette in app.css.</summary>
    private static string WallboxFarbe(string wallbox) => wallbox switch
    {
        LadeTopics.Garage => "var(--laden-farbe-wallbox-garage)",
        LadeTopics.Stellplatz => "var(--laden-farbe-wallbox-stellplatz)",
        _ => "var(--laden-farbe-wallbox-sonstige)",
    };

    protected override void OnInitialized()
    {
        UpdateChargingSituation();
        UpdateChargingSettings();

        MqttService.OnMessageReceived += UpdateData;
    }

    private void UpdateData(object sender, MqttMessageReceivedEventArgs args)
    {
        if (args.Topic == LadeTopics.Situation)
        {
            UpdateChargingSituation();
        }
        else if (args.Topic == LadeTopics.Einstellungen)
        {
            UpdateChargingSettings();
        }
        else if (LadeTopics.ZerlegeStatusTopic(args.Topic) is not null
                 || FahrzeugTopics.ZerlegeStatusTopic(args.Topic) is not null
                 || LadeTopics.ZerlegeZuordnungTopic(args.Topic) is not null)
        {
            // The tiles and cards read their state straight out of MqttService.Wallboxen and
            // MqttService.Fahrzeuge, so a status message only has to trigger a render. That
            // also keeps the session duration ticking: the box reports every few seconds.
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Which station of <see cref="SharedContracts.ChargingSettings"/> a box is. The contract
    /// still calls them Inside and Outside; renaming it would touch the ChargingController and
    /// is a backlog item of its own, so the mapping lives here — once.
    /// </summary>
    private static ChargingStation Station(string wallbox) => wallbox switch
    {
        LadeTopics.Garage => ChargingStation.Inside,
        LadeTopics.Stellplatz => ChargingStation.Outside,
        // A third box would have no enable of its own in the contract, so it stays unassigned
        // instead of silently sharing the enable of the outside one.
        _ => ChargingStation.None,
    };

    private bool IstFreigegeben(string wallbox) => Station(wallbox) switch
    {
        ChargingStation.Inside => chargingSettings.InsideChargingEnabled,
        ChargingStation.Outside => chargingSettings.OutsideChargingEnabled,
        _ => false,
    };

    /// <summary>
    /// One click, one switch, one publication. The enables are two independent booleans, so
    /// each box has its own — that is what the three vehicle tiles could not do, where Mini and
    /// VW both operated OutsideChargingEnabled.
    /// </summary>
    private async Task FreigabeUmschalten(string wallbox)
    {
        switch (Station(wallbox))
        {
            case ChargingStation.Inside:
                chargingSettings.InsideChargingEnabled = !chargingSettings.InsideChargingEnabled;
                break;
            case ChargingStation.Outside:
                chargingSettings.OutsideChargingEnabled = !chargingSettings.OutsideChargingEnabled;
                break;
            default:
                return;
        }
        await CommunicateSettings();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The preference is a single enum for the whole system, so the two switches behave like
    /// radio buttons: setting one clears the other, and clicking the one that is set gives the
    /// preference up altogether.
    /// </summary>
    private async Task VorrangUmschalten(string wallbox)
    {
        var station = Station(wallbox);
        if (station == ChargingStation.None)
        {
            return;
        }
        chargingSettings.PreferedChargingStation =
            chargingSettings.PreferedChargingStation == station ? ChargingStation.None : station;
        await CommunicateSettings();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Corrects which vehicle is charging at a box. Published retained to the configuration
    /// topic; the RulesEngine picks it up and raises the assignment to "bestätigt".
    /// </summary>
    /// <remarks>
    /// The session the box reports right now is written into the payload, and that is what
    /// makes the correction expire: the rule only evaluates an override whose session matches
    /// the running one, so pulling the plug retires it without anybody having to withdraw it.
    /// Without a running session there is nothing to correct, and publishing anyway would leave
    /// a message behind that never matches anything.
    /// </remarks>
    private async Task ZuordnungSetzen(string wallbox, string fahrzeug)
    {
        var sitzung = MqttService.Wallboxen.GetValueOrDefault(wallbox)?.SitzungsId;
        if (sitzung is null)
        {
            return;
        }

        var korrektur = new FahrzeugZuordnung
        {
            Zeitpunkt = DateTimeOffset.UtcNow,
            SitzungsId = sitzung,
            Fahrzeug = fahrzeug,
            Vertrauen = Vertrauensgrad.Bestaetigt,
        };

        await MqttService.PublishAsync(
            LadeTopics.ZuordnungKorrektur(wallbox),
            JsonSerializer.Serialize(korrektur),
            MqttQualityOfServiceLevel.AtLeastOnce,
            true);
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateChargingSituation()
    {
        _chargingSituation = MqttService.ChargingSituation;

        availabilityData = ChargingSituationManager.CalculateAvailabilityData(
            _chargingSituation.PowerFromPV,
            _chargingSituation.PowerFromBattery,
            _chargingSituation.PowerFromGrid);
        consumptionData = ChargingSituationManager.CalculateConsumptionData(
            HausOhneWallboxen,
            _chargingSituation.PowerFromBattery, 
            _chargingSituation.PowerFromGrid,
            _chargingSituation.InsideCurrentChargingPower,
            _chargingSituation.OutsideCurrentChargingPower);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateChargingSettings()
    {
        chargingSettings = MqttService.ChargingSettings;
        InvokeAsync(StateHasChanged);
    }

    private string FormatPower(int value)
    {
        return value.ToString("#,##0 W");
    }

    /// <summary>
    /// One click, one level, one publication. This used to be six identical methods, each
    /// <c>async void</c> and each dropping the task of CommunicateSettings on the floor
    /// (CS4014) - a failed publication could not be noticed anywhere.
    /// </summary>
    private async Task StufeSetzen(int stufe)
    {
        chargingSettings.ChargingLevel = stufe;
        await CommunicateSettings();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CommunicateSettings()
    {
        chargingSettings.Zeitpunkt = DateTimeOffset.UtcNow;
        await MqttService.PublishAsync(
            LadeTopics.Einstellungen,
            JsonSerializer.Serialize(chargingSettings),
            MqttQualityOfServiceLevel.AtLeastOnce,
            true);
    }
}