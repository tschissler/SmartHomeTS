@page "/"

@using SharedContracts
@using SmartHome.Web.Services

@using ColorHelper;
@using System.Text.Json
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject MqttService MqttService

@rendermode InteractiveServer

<PageTitle>Beleuchtung</PageTitle>

<h3>Beleuchtung</h3>

@*
    Drei Schieberegler. Sie waren SfLinearGauge mit einem ziehbaren Zeiger -- also Anzeiger,
    die als Bedienelement benutzt wurden. <input type="range"> bildet das eins zu eins ab:
    oninput ist der laufende Zug, onchange das Loslassen. Am Telefon ist der Unterschied
    spuerbar: Ein nativer Regler hat die Trefferflaeche, die das Betriebssystem fuer einen
    Finger vorsieht, der Syncfusion-Zeiger war ein 40-px-Kreis zum Ziehen.

    Wichtig ist die Trennung dahinter: Nur das Loslassen veroeffentlicht nach MQTT. Wuerde
    jeder Zwischenwert gesendet, bekaeme der LED-Streifen bei einem einzigen Zug hunderte
    Nachrichten.
*@
<div class="regler">
    <label for="regler-farbton">Farbton</label>
    <input type="range" id="regler-farbton" class="regler-spur regler-farbton"
           min="0" max="360" step="1" value="@HueValue"
           @oninput="ZiehtFarbton" @onchange="LaesstFarbtonLos" />
</div>

<div class="regler">
    <label for="regler-helligkeit">Helligkeit</label>
    <input type="range" id="regler-helligkeit" class="regler-spur regler-helligkeit"
           min="0" max="100" step="1" value="@BrightnessValue"
           @oninput="ZiehtHelligkeit" @onchange="LaesstHelligkeitLos" />
</div>

<div class="regler">
    <label for="regler-dichte">Dichte</label>
    <input type="range" id="regler-dichte" class="regler-spur regler-dichte"
           min="0" max="101" step="1" value="@DensityValue"
           @oninput="ZiehtDichte" @onchange="LaesstDichteLos" />
</div>

@* Ein Kontrollkaestchen mit CSS statt eines SfSwitch. Das Kaestchen selbst bleibt das
   Bedienelement -- Tastatur und Vorlesesoftware funktionieren damit weiter, die Optik liegt
   allein im Stylesheet. *@
<div class="schalterZeile">
    <label class="schalter">
        <input type="checkbox" checked="@(SchrankbeleuchtungOnOff == true)"
               @onchange="SchrankbeleuchtungUmschalten" />
        <span class="schalterBahn"></span>
    </label>
    <span>Schrank-Beleuchtung</span>
</div>

<div class="schalterZeile">
    <label class="schalter">
        <input type="checkbox" checked="@(LampeOnOff == true)"
               @onchange="LampeUmschalten" />
        <span class="schalterBahn"></span>
    </label>
    <span>Wohnzimmerlampe</span>
</div>

<div class="farbprobeZeile">
    <div class="farbprobe" style="background-color:@RGBColor.ToString()"></div>
    <div>
        <div>R=@RGBColor.R  G=@RGBColor.G  B=@RGBColor.B</div>
        <div class="farbprobeSub">Dichte @DensityValue %</div>
    </div>
</div>

<div>@StatusMessage</div>

@code {
    public int HueValue = 30;
    private const string topicName = "commands/illumination/LEDStripe/setColor";
    private const string lampeTopicName = "commands/shelly/Lampe";
    public int BrightnessValue = 50;
    public int DensityValue = 10;
    public RGB RGBColor = new RGB(0, 0, 0);
    public string StatusMessage = "Ready";
    public bool? SchrankbeleuchtungOnOff = true;
    public bool? LampeOnOff = true;
    public IluminationSituation situation = new IluminationSituation();

    /// <summary>
    /// Value of a slider. The browser sends it as text; anything unreadable keeps the value
    /// that is already set rather than silently jumping the strip to zero.
    /// </summary>
    private static int Wert(ChangeEventArgs args, int bisher) =>
        int.TryParse(args.Value?.ToString(), out var wert) ? wert : bisher;

    private void ZiehtFarbton(ChangeEventArgs args) => HueValue = Wert(args, HueValue);

    private Task LaesstFarbtonLos(ChangeEventArgs args)
    {
        HueValue = Wert(args, HueValue);
        return UebernehmenAsync();
    }

    private void ZiehtHelligkeit(ChangeEventArgs args) => BrightnessValue = Wert(args, BrightnessValue);

    private Task LaesstHelligkeitLos(ChangeEventArgs args)
    {
        BrightnessValue = Wert(args, BrightnessValue);
        return UebernehmenAsync();
    }

    private void ZiehtDichte(ChangeEventArgs args) => DensityValue = Wert(args, DensityValue);

    private Task LaesstDichteLos(ChangeEventArgs args)
    {
        DensityValue = Wert(args, DensityValue);
        return UebernehmenAsync();
    }

    /// <summary>
    /// Sends the setting to the strip - but only while the cabinet light is on. Dragging a
    /// slider on a switched off strip changes what will be set the next time it is switched
    /// on, and nothing else; that was the behaviour of the three OnDragEnd handlers before.
    /// </summary>
    private async Task UebernehmenAsync()
    {
        if (SchrankbeleuchtungOnOff == true)
        {
            await CalculateRGBColor();
        }
    }

    private async Task SchrankbeleuchtungUmschalten(ChangeEventArgs args)
    {
        SchrankbeleuchtungOnOff = args.Value as bool? ?? false;
        StatusMessage = SchrankbeleuchtungOnOff == true ? "Eingeschaltet" : "Ausgeschaltet";
        // Deliberately not through UebernehmenAsync: switching off has to be published as
        // well, and that is the one case UebernehmenAsync leaves out.
        await CalculateRGBColor();
    }

    private async Task LampeUmschalten(ChangeEventArgs args)
    {
        LampeOnOff = args.Value as bool? ?? false;
        await MqttService.PublishAsync(
            lampeTopicName,
            LampeOnOff == true ? "on" : "off",
            MQTTnet.Protocol.MqttQualityOfServiceLevel.AtLeastOnce,
            true);
    }

    private async Task CalculateRGBColor()
    {
        RGBColor = ColorConverter.HslToRgb(new HSL(HueValue, 100, (byte)BrightnessValue));
        await SendRGBColor(RGBColor, DensityValue);
    }

    private async Task SendRGBColor(RGB rGBColor, int densityValue)
    {
        IluminationSituation situation = new IluminationSituation();
        situation.Right.Red = rGBColor.R;
        situation.Right.Green = rGBColor.G;
        situation.Right.Blue = rGBColor.B;
        situation.Right.Density = densityValue;
        situation.Right.On = SchrankbeleuchtungOnOff!.Value;
        situation.Left.Red = rGBColor.R;
        situation.Left.Green = rGBColor.G;
        situation.Left.Blue = rGBColor.B;
        situation.Left.Density = densityValue;
        situation.Left.On = SchrankbeleuchtungOnOff!.Value;
        situation.LampOn = LampeOnOff!.Value;

        var jsonString = JsonSerializer.Serialize(situation);
        await MqttService.PublishAsync(topicName, jsonString, MQTTnet.Protocol.MqttQualityOfServiceLevel.AtLeastOnce, true);
    }

    protected override void OnInitialized()
    {
        MqttService.OnMessageReceived += UpdateData;
        UpdateValues();
    }

    private void UpdateData(object? sender, MqttMessageReceivedEventArgs args)
    {
        if (args.Topic == topicName || args.Topic == lampeTopicName)
            UpdateValues();
    }

    private void UpdateValues()
    {
        situation = MqttService.IluminationSituation;
        DensityValue = situation.Right.Density;
        var hsl = ColorConverter.RgbToHsl(new RGB(situation.Right.Red, situation.Right.Green, situation.Right.Blue));
        HueValue = hsl.H;
        BrightnessValue = hsl.L;
        SchrankbeleuchtungOnOff = situation.Right.On;
        LampeOnOff = situation.LampOn;
        RGBColor = new RGB(situation.Right.Red, situation.Right.Green, situation.Right.Blue);
        InvokeAsync(StateHasChanged);
    }
}
