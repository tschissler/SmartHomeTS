@using SharedContracts

@*
    One wallbox, as the box itself reports it. The tile is always rendered: a box without a
    vehicle is an operating state and belongs on screen, not hidden away.

    Everything about the charging process comes from WallboxStatus — the box is the truth, the
    vehicle only supplies identity and vehicle data. See Docs/Fahrzeug-Wallbox-Zuordnung.md.
    The assignment is a label on top of that and never a precondition: every value below is
    shown whether or not a vehicle could be named.
*@

<div class="wallboxBox">
    <div class="wallboxHeader">
        <span class="wallboxName">@Name</span>
        <span class="wallboxZustand @ZustandKlasse" title="@SteckerHinweis">
            @*
                The symbol answers exactly one question: does a vehicle hang on the cable? Drawn
                in currentColor, so it always carries the colour of the state written next to it
                and cannot contradict it. Inline instead of /images/*.svg because those carry
                their colour hard-coded - disconnected.svg is amber throughout, which put an
                attention colour on the most ordinary state a box has.
            *@
            <svg class="wallboxZustandIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                @if (FahrzeugAmKabel)
                {
                    <path d="m 8.4644661,11.96603 h 7.0710679 v 2.12132 a 3.536,3.536 0 1 1 -7.0710679,0 z" stroke-width="0.8" />
                    <path d="M 15.535534,12.03397 H 8.4644661 V 9.9126506 a 3.536,3.536 0 1 1 7.0710679,0 z" stroke-width="0.8" />
                    <path d="M 12,24.54471 V 18.200712" stroke-width="1.07163" />
                    <path d="M 12,5.9834864 V -0.50983784" stroke-width="1.08417" />
                }
                else
                {
                    <path d="m 8.4644661,15.535534 h 7.0710679 l 0,2.12132 a 3.536,3.536 0 1 1 -7.0710679,0 z" stroke-width="0.8" />
                    <path d="M 15.535534,8.4644661 H 8.4644661 V 6.3431458 a 3.536,3.536 0 1 1 7.0710679,0 z" stroke-width="0.8" />
                    <path d="M 12,24.862451 V 21.326917" stroke-width="0.8" />
                    <path d="M 12,2.6999885 V -0.83554538" stroke-width="0.8" />
                    <path d="m 9.8786797,12.707107 v 2.828427" stroke-width="0.8" />
                    <path d="m 14.12132,12.707107 v 2.828427" stroke-width="0.8" />
                }
            </svg>
            @ZustandText
        </span>
    </div>

    @if (SitzungLaeuft)
    {
        @*
            Text, symbol and colour answer the same question — how sure is this? — the way the
            plug state above does. A tick in normal type means the assignment can be relied on,
            a question mark in grey means it is a guess, and the word says which of the two
            grades it is. A grey question mark next to a name in normal type would be exactly
            the contradiction that backlog item 9b removed from the state line.
        *@
        <div class="wallboxZuordnung @(ZuordnungIstSicher ? "wallboxZuordnung-sicher" : "wallboxZuordnung-unsicher")"
             @onclick="AuswahlUmschalten" title="@ZuordnungHinweis">
            <span class="wallboxZuordnungZeichen">@(ZuordnungIstSicher ? "✓" : "?")</span>
            <span class="wallboxZuordnungFahrzeug">@ZuordnungFahrzeug</span>
            <span class="wallboxZuordnungGrad">@ZuordnungGrad</span>
        </div>

        @if (auswahlOffen)
        {
            <div class="wallboxZuordnungAuswahl">
                @foreach (var fahrzeug in Fahrzeuge)
                {
                    <span class="wallboxZuordnungWahl @(fahrzeug == ZuordnungsFahrzeugName ? "wallboxZuordnungWahl-aktiv" : "")"
                          @onclick="@(() => Waehle(fahrzeug))">
                        @fahrzeug
                    </span>
                }
            </div>
        }
    }

    @if (Status is null)
    {
        <div class="wallboxKeineDaten">
            Keine Daten von der Box
        </div>
    }
    else
    {
        <div class="wallboxWerte">
            <div class="wallboxLabel">Leistung</div>
            <div class="wallboxWert">@FormatiereLeistung(Status.Ladeleistung) @PhasenText</div>

            <div class="wallboxLabel">Sollstrom</div>
            <div class="wallboxWert">@FormatiereStrom(Status.SollstromMa)</div>

            <div class="wallboxLabel">Sitzungsenergie</div>
            <div class="wallboxWert">@FormatiereEnergie(Status.EnergieSitzungWh)</div>

            <div class="wallboxLabel">Sitzungsdauer</div>
            <div class="wallboxWert @(DauerIstUngenau ? "wallboxUngenau" : "")" title="@DauerHinweis">
                @DauerText
            </div>
        </div>

        @if (Alter is not null)
        {
            <div class="wallboxVeraltet" title="Die Box meldet ihren Zustand alle paar Sekunden. Bleibt die Meldung aus, steht hier ein alter Wert.">
                Stand @FormatiereDauer(Alter.Value) alt
            </div>
        }
    }

    <div class="wallboxBedienung">
        <span class="wallboxSchalter" @onclick="FreigabeUmschalten"
              title="Gibt diese Wallbox für die Regelung frei">
            <img class="wallboxSchalterIcon" src="/images/@(Freigegeben ? "checked.svg" : "unchecked.svg")" alt="" />
            Freigabe
        </span>
        <span class="wallboxSchalter" @onclick="VorrangUmschalten"
              title="Diese Wallbox wird zuerst bedient, wenn beide freigegeben sind. Der Vorrang gilt immer nur für eine Box.">
            <span class="wallboxStern">@(Priorisiert ? "★" : "☆")</span>
            Vorrang
        </span>
    </div>
</div>

@code {
    /// <summary>
    /// Device states of the box that get a wording of their own, as documented on
    /// <see cref="WallboxStatus.DeviceState"/>. States 1 (not ready for charging) and 2 (ready,
    /// waiting for the vehicle) need none: what matters about them is whether something is
    /// plugged in, and the plug status says that more precisely. Named here rather than in the
    /// contract so that the merge does not rebuild the five other services using it.
    /// </summary>
    private const int ZustandStartet = 0;
    private const int ZustandLaedt = 3;
    private const int ZustandFehler = 4;
    private const int ZustandUnterbrochen = 5;

    /// <summary>
    /// Plug state 5: cable in the station and in the vehicle, but not locked — the vehicle is
    /// connected, yet the box cannot charge in this state.
    /// </summary>
    private const int PlugStatusNichtVerriegelt = 5;

    /// <summary>Plug state 1: cable lying in the station, nothing on the other end.</summary>
    private const int PlugStatusKabelInBox = 1;

    /// <summary>
    /// Plug state 3: cable in the station and locked there, still nothing on the other end. A box
    /// with a fixed cable reports this permanently while idle — the Garage does — so it says
    /// nothing at all about whether a vehicle is present.
    /// </summary>
    private const int PlugStatusKabelInBoxVerriegelt = 3;

    /// <summary>
    /// A phase counts as carrying current above this. Well below the 6 A minimum charging
    /// current, well above what the measurement shows on an idle phase.
    /// </summary>
    private const int StromfuehrendAbMa = 500;

    /// <summary>A status older than this is shown with its age instead of as current.</summary>
    private static readonly TimeSpan MaxAlter = TimeSpan.FromSeconds(30);

    /// <summary>Name of the box as it appears in the topic, e.g. "Garage".</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    /// <summary>
    /// Latest state of the box, null while nothing has arrived on its status topic — which is
    /// a different thing from an empty box and is shown as such.
    /// </summary>
    [Parameter]
    public WallboxStatus? Status { get; set; }

    /// <summary>Whether the controller may charge at this box.</summary>
    [Parameter]
    public bool Freigegeben { get; set; }

    /// <summary>Whether this box is the preferred one.</summary>
    [Parameter]
    public bool Priorisiert { get; set; }

    /// <summary>
    /// Toggles the enable of this box. The parent owns the settings and publishes them once —
    /// the tile never publishes, so one click can only ever produce one retained message.
    /// </summary>
    [Parameter]
    public EventCallback FreigabeUmschalten { get; set; }

    /// <summary>Toggles the preference for this box; the parent clears the other one.</summary>
    [Parameter]
    public EventCallback VorrangUmschalten { get; set; }

    /// <summary>
    /// What the RulesEngine says about this box, or null while it has said nothing. It may
    /// describe an earlier session — see <see cref="ZuordnungDerSitzung"/>.
    /// </summary>
    [Parameter]
    public FahrzeugZuordnung? Zuordnung { get; set; }

    /// <summary>The vehicles that can be picked in a correction.</summary>
    [Parameter]
    public IReadOnlyList<string> Fahrzeuge { get; set; } = [];

    /// <summary>
    /// Corrects the assignment of this box. The parent owns the publication, the same way it
    /// owns the settings — one click can then only ever produce one retained message.
    /// </summary>
    [Parameter]
    public EventCallback<string> ZuordnungSetzen { get; set; }

    private bool auswahlOffen;

    /// <summary>
    /// Whether a session is running that an assignment could be about. Without one the tile
    /// says nothing about vehicles: the retained assignment of the last session is still
    /// standing — it is the history the next guess comes from — and showing it on a free box
    /// would read as "this car is charging here".
    /// </summary>
    private bool SitzungLaeuft => Status?.SitzungsId is not null;

    /// <summary>The assignment, but only when it is about the session running now.</summary>
    private FahrzeugZuordnung? ZuordnungDerSitzung =>
        Zuordnung is not null && Status?.SitzungsId is not null && Zuordnung.SitzungsId == Status.SitzungsId
            ? Zuordnung
            : null;

    private string? ZuordnungsFahrzeugName => ZuordnungDerSitzung?.Fahrzeug;

    /// <summary>
    /// Whether the assignment can be relied on. Confirmed and recognised both can; a guess and
    /// an outright unknown both cannot, and they look alike because for reading a number off
    /// the tile they mean the same thing.
    /// </summary>
    private bool ZuordnungIstSicher =>
        ZuordnungsFahrzeugName is not null
        && ZuordnungDerSitzung!.Vertrauen >= Vertrauensgrad.Erkannt;

    private string ZuordnungFahrzeug => ZuordnungsFahrzeugName ?? "kein Fahrzeug erkannt";

    private string ZuordnungGrad => ZuordnungsFahrzeugName is null
        ? ""
        : ZuordnungDerSitzung!.Vertrauen switch
        {
            Vertrauensgrad.Bestaetigt => "· bestätigt",
            Vertrauensgrad.Erkannt => "· erkannt",
            Vertrauensgrad.Vermutet => "· vermutet",
            _ => "",
        };

    private string ZuordnungHinweis => ZuordnungDerSitzung?.Vertrauen switch
    {
        Vertrauensgrad.Bestaetigt => "Von Hand für diese Ladesitzung bestätigt. Klicken, um es zu ändern.",
        Vertrauensgrad.Erkannt => "Aus der Meldung des Fahrzeugs und der Belegung der Boxen ermittelt. "
            + "Klicken, um es zu korrigieren.",
        Vertrauensgrad.Vermutet => "Nur vermutet — das Fahrzeug, das zuletzt an dieser Box lud. "
            + "Klicken, um es zu korrigieren.",
        _ => "Kein Fahrzeug erkannt. Klicken, um es zu benennen.",
    };

    private void AuswahlUmschalten() => auswahlOffen = !auswahlOffen;

    private async Task Waehle(string fahrzeug)
    {
        auswahlOffen = false;
        await ZuordnungSetzen.InvokeAsync(fahrzeug);
    }

    /// <summary>
    /// The question this tile answers is "is a vehicle hanging there?", not "is a cable stuck in
    /// the box?". Plug states 0, 1 and 3 all mean the same for it: no vehicle, box free. Only
    /// the device state may override that wording, because charging, error and interruption are
    /// statements the plug state cannot make.
    /// </summary>
    private string ZustandText => Status switch
    {
        null => "unbekannt",
        { DeviceState: ZustandFehler } => "Fehler",
        { DeviceState: ZustandLaedt } => "lädt",
        { DeviceState: ZustandUnterbrochen } => "unterbrochen",
        { DeviceState: ZustandStartet } => "startet",
        { FahrzeugVerbunden: true } => "verbunden, wartet",
        { PlugStatus: PlugStatusNichtVerriegelt } => "verbunden, nicht verriegelt",
        _ => "frei",
    };

    /// <summary>
    /// Colour follows the same reading as the text. An attention colour only where a vehicle is
    /// waiting or something is wrong — never on a free box, whatever its cable is doing.
    /// </summary>
    private string ZustandKlasse => Status switch
    {
        null => "wallboxZustand-unbekannt",
        { DeviceState: ZustandFehler } => "wallboxZustand-fehler",
        { DeviceState: ZustandLaedt } => "wallboxZustand-laedt",
        { DeviceState: ZustandUnterbrochen } => "wallboxZustand-unterbrochen",
        _ when FahrzeugAmKabel => "wallboxZustand-wartet",
        _ => "wallboxZustand-frei",
    };

    /// <summary>
    /// Whether a vehicle hangs on the cable. Plug states 5 and 7 are the two that reach the
    /// vehicle; 0, 1 and 3 are the box alone with its cable, locked or not.
    /// </summary>
    private bool FahrzeugAmKabel => Status is
        { PlugStatus: PlugStatusNichtVerriegelt or WallboxStatus.PlugStatusFahrzeugVerbunden };

    /// <summary>
    /// Where the cable is, in words. Kept as a tooltip rather than as the state: for a box with a
    /// fixed cable it never changes, so as a state it would stand there permanently and say
    /// nothing — while on a box with a socket it is worth being able to look up.
    /// </summary>
    private string SteckerHinweis => Status switch
    {
        null => "",
        { PlugStatus: WallboxStatus.PlugStatusFahrzeugVerbunden }
            => "Kabel steckt in der Box und im Fahrzeug, verriegelt.",
        { PlugStatus: PlugStatusNichtVerriegelt }
            => "Kabel steckt in der Box und im Fahrzeug, aber nicht verriegelt — so kann die Box nicht laden.",
        { PlugStatus: PlugStatusKabelInBoxVerriegelt }
            => "Kabel steckt in der Box und ist dort verriegelt. Kein Fahrzeug daran.",
        { PlugStatus: PlugStatusKabelInBox }
            => "Kabel liegt in der Box. Kein Fahrzeug daran.",
        _ => "Kein Kabel in der Box.",
    };

    /// <summary>How many phases carry current, derived from the three measured currents.</summary>
    private int Phasen => Status is null
        ? 0
        : (Status.StromPhase1Ma >= StromfuehrendAbMa ? 1 : 0)
          + (Status.StromPhase2Ma >= StromfuehrendAbMa ? 1 : 0)
          + (Status.StromPhase3Ma >= StromfuehrendAbMa ? 1 : 0);

    private string PhasenText => Phasen == 0 ? "" : $"· {Phasen}-phasig";

    /// <summary>
    /// True when the session start came from the clock of the box instead of an observed
    /// plug-in edge. That clock is not synchronised, so the duration may be arbitrarily
    /// wrong and must not be shown as an exact value.
    /// </summary>
    private bool DauerIstUngenau => Status?.SitzungsBeginnAusBoxZeit == true;

    private TimeSpan? Dauer
    {
        get
        {
            if (Status?.SitzungsBeginn is null) return null;
            var dauer = DateTimeOffset.UtcNow - Status.SitzungsBeginn.Value;
            // A box clock running ahead yields a negative duration - that is not a duration.
            return dauer < TimeSpan.Zero ? null : dauer;
        }
    }

    private string DauerText
    {
        get
        {
            if (Status?.SitzungsId is null) return "keine Sitzung";
            if (Dauer is null) return "unbekannt";
            if (DauerIstUngenau) return $"ca. {FormatiereDauer(Dauer.Value)}";
            return $"{FormatiereDauer(Dauer.Value)} · seit {Status.SitzungsBeginn!.Value.ToLocalTime():HH:mm}";
        }
    }

    private string DauerHinweis => DauerIstUngenau
        ? "Die Box lief bereits, als der Connector startete. Der Beginn stammt deshalb aus der "
          + "unsynchronisierten Uhr der Wallbox und kann beliebig falsch sein."
        : "";

    /// <summary>Age of the status, but only once it exceeds what the box normally takes.</summary>
    private TimeSpan? Alter
    {
        get
        {
            if (Status is null) return null;
            var alter = DateTimeOffset.UtcNow - Status.Zeitpunkt;
            return alter > MaxAlter ? alter : null;
        }
    }

    private static string FormatiereLeistung(int watt) => watt < 1000
        ? watt.ToString("#,##0 W")
        : (watt / 1000.0).ToString("0.0 kW");

    private static string FormatiereStrom(int milliampere) => (milliampere / 1000.0).ToString("0.0 A");

    private static string FormatiereEnergie(int wattstunden) => (wattstunden / 1000.0).ToString("0.00 kWh");

    private static string FormatiereDauer(TimeSpan dauer) => dauer.TotalHours >= 1
        ? $"{(int)dauer.TotalHours} h {dauer.Minutes} min"
        : dauer.TotalMinutes >= 1
            ? $"{(int)dauer.TotalMinutes} min"
            : $"{(int)dauer.TotalSeconds} s";
}
