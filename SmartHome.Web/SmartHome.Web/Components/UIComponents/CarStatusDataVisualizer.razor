@using SharedContracts

@*
    What a vehicle reports about itself: charge level, target, range, mileage. Nothing here
    says which wallbox the vehicle is at — the box is the truth about a charging process and
    carries its own tile, see Docs/Fahrzeug-Wallbox-Zuordnung.md. Assigning a vehicle to a box
    is backlog item 11, the full vehicle card is item 10.

    Enable and preference used to be operated from here. They belong to the box and moved to
    WallboxStatusVisualizer: two of these three tiles were bound to the same
    OutsideChargingEnabled, so the interface could not even show one box released and the
    other blocked.
*@

<div class="carBox">
    <div class="carImageContainer">
        <img class="carImage" src="/images/@(GetCarImage(CarStatusData.Brand))" />
        <br />
        <span style="font-size: 0.7rem">@(new MarkupString(CarStatusData.LastUpdate?.ToLocalTime().ToString("dd.MM.yy HH:mm:ss")??""))</span>
        <br />
        @CarStatusData.Mileage km >>
        @CarStatusData.RemainingRange km
    </div>
    <div class="carControls">
        <img class="carConnectedIcon" src="/images/@(CarStatusData.ChargerConnected ? "connected.svg" : "disconnected.svg")"
             title="So meldet es das Fahrzeug selbst. Ob an einer der Wallboxen geladen wird, sagen die Kacheln oben." />
        <div class="batteryInformationContainer">
            <div class="batteryBorder">
                <div class="batteryLevel" style="height: @CarStatusData.Battery%"></div>
            </div>
            <div class="batteryLabel">
                @CarStatusData.Battery % / @CarStatusData.ChargingTarget %<br />
                @if (CarStatusData.ChargingEndTime.HasValue && CarStatusData.ChargingEndTime > DateTime.UtcNow)
                {
                    <span>Bis: </span>
                    @CarStatusData.ChargingEndTime?.ToLocalTime().ToString("HH:mm")
                    <br/>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public CarStatusData CarStatusData { get; set; } = new();

    public string GetCarImage(string brand)
    {
        switch (brand.ToLower())
        {
            case "bmw":
                return "BMW.webp";
            case "mini":
                return "CarBrands.MINI_VehicleViewDirection.ANGLE_SIDE_VIEW_FORTY.jpg";
            case "vw":
                return "ID4.png";
        }
        return "empty.png";
    }
}
